{
  "appName": "Charles Websites",
  "appId": "tech.charleswebsites.app",
  "environments": {
    "development": {
      "url": "http://localhost:3000",
      "envVarOverride": "NEXT_PUBLIC_DEV_APP_URL"
    },
    "production": {
      "url": "https://charleswebsites.tech",
      "envVarOverride": "NEXT_PUBLIC_SITE_URL"
    }
  },
  "clients": {
    "android": {
      "packageName": "tech.charleswebsites.android",
      "shell": "TWA / Capacitor WebView",
      "productionTargetUrl": "https://charleswebsites.tech",
      "releaseDownloadEnvVar": "NEXT_PUBLIC_ANDROID_DOWNLOAD_URL"
    },
    "ios": {
      "bundleId": "tech.charleswebsites.ios",
      "shell": "WKWebView / Capacitor",
      "productionTargetUrl": "https://charleswebsites.tech",
      "releaseDownloadEnvVar": "NEXT_PUBLIC_IOS_DOWNLOAD_URL"
    },
    "windows": {
      "appUserModelId": "tech.charleswebsites.desktop",
      "shell": "WebView2 / Desktop PWA",
      "productionTargetUrl": "https://charleswebsites.tech",
      "releaseDownloadEnvVar": "NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL"
    }
  },
  "releaseOrder": [
    "1. Deploy Next.js production build to Hostinger Node.js Web App",
    "2. Connect charleswebsites.tech DNS & enable SSL certificate",
    "3. Verify https://charleswebsites.tech responds HTTP 200",
    "4. Build & sign Android, iOS, and Windows shells pointing to https://charleswebsites.tech",
    "5. Set genuine NEXT_PUBLIC_*_DOWNLOAD_URL environment variables and redeploy"
  ]
}
