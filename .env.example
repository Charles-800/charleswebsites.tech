# ==============================================================================
# CHARLES WEBSITES — ENVIRONMENT CONFIGURATION TEMPLATE (DEVELOPMENT DEFAULT)
# ==============================================================================
# Copy to `.env.local` for local development.
# Do NOT commit `.env`, `.env.local`, or `.env.production` to GitHub.

# Environment selector: "development" | "production"
NEXT_PUBLIC_APP_ENV="development"

# Active Base URL:
# - Development: http://localhost:3000 (or leave blank in Google AI Studio)
# - Production (Hostinger): https://charleswebsites.tech
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEV_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRODUCTION_URL="https://charleswebsites.tech"

# Server-side Base URL fallback (auto-injected in cloud environments or set for Hostinger)
APP_URL=""

# Official App Installer Packages (Leave blank to show "Coming Soon" in DOWNLOAD OUR APP modal)
# Only populate after https://charleswebsites.tech is live and genuine signed packages are hosted.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=""
NEXT_PUBLIC_IOS_DOWNLOAD_URL=""
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=""

# Contact Inquiry Delivery Target
CONTACT_RECIPIENT_EMAIL="ramoyacharles920@gmail.com"

# SMTP Email Configuration (Recommended for Hostinger Email or Gmail App Password)
# For Hostinger Email: SMTP_HOST="smtp.hostinger.com", SMTP_PORT="465", SMTP_SECURE="true"
# For Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER="ramoyacharles920@gmail.com", SMTP_PASS="<16-char-app-password>"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Optional Resend API Key (alternative transactional email provider)
RESEND_API_KEY=""

# Optional Universal Webhook URL (Formspree, Make, Zapier, Discord, Slack, or Google Apps Script)
CONTACT_WEBHOOK_URL=""

# Optional Admin Bearer Keys to restrict write endpoints in production
BLOG_ADMIN_KEY=""
CERTIFICATIONS_ADMIN_KEY=""

# Optional Verified Agency Social Links (only rendered in Footer & JSON-LD when set)
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_GITHUB_URL=""
